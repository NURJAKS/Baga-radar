# Настройки локального сервиса relay.py. Скопируйте в .env и заполните.
# Файл .env в репозиторий не попадает.

# Токен бота от @BotFather. Если токен был где-то показан — перевыпустите его
# командой /revoke и вставьте сюда новый.
TG_TOKEN=

# Чат или канал, куда поступают обращения граждан.
# Узнать: напишите боту любое сообщение и выполните `python3 relay.py --chat-id`
TG_CHAT_ID=
